# Local development defaults. The suite falls back to these values when the
# variables are unset, so copying this file is optional.
#
# These are throwaway credentials for a disposable local container. Do not
# reuse this shape for anything that holds real data.

PGHOST=localhost
PGPORT=5433

# Superuser. Owns the schema, runs migrations, provisions test databases.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5433/tenantwell

# The least-privileged application role. Every request path uses this.
APP_DATABASE_URL=postgres://tenantwell_app:tenantwell_app_local@localhost:5433/tenantwell
