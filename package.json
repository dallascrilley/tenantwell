{
  "name": "tenantwell",
  "version": "0.1.0",
  "description": "Postgres row level security multi-tenancy, with the isolation test that proves it.",
  "license": "MIT",
  "author": "Dallas Crilley <dallas@dallascrilley.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "tenantwell": "./dist/cli.js"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallascrilley/tenantwell.git"
  },
  "bugs": {
    "url": "https://github.com/dallascrilley/tenantwell/issues"
  },
  "homepage": "https://github.com/dallascrilley/tenantwell#readme",
  "keywords": [
    "postgres",
    "postgresql",
    "rls",
    "row-level-security",
    "multi-tenancy",
    "database-security",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "migrate": "tsx src/cli.ts migrate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
